<Window x:Class="_2PlayerMiniGames.WasdArrowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WASD vs Nyilak - 2 játékos" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid Background="#20232A" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText"
               Foreground="White"
               FontSize="30"
               FontWeight="Bold"
               Text="Piros: WASD, Kék: nyilak."
               HorizontalAlignment="Center"/>

            <TextBlock x:Name="TimerText"
               Text="Idő: 30 másodperc"
               Foreground="White"
               FontSize="26" 
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,5,0,0"/>
        </StackPanel>

        <Canvas x:Name="GameCanvas"
                Grid.Row="1"
                Background="#282C34"
                Margin="0,0,0,10">
            <Rectangle x:Name="RedPlayer"
                       Width="50" Height="50"
                       Fill="Red"/>
            <Rectangle x:Name="BluePlayer"
                       Width="50" Height="50"
                       Fill="DeepSkyBlue"/>
        </Canvas>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button Content="Új játék" Margin="0,0,0,10" Height="50" Width="150" FontSize="30" Click="NewGame_Click"/>
            <TextBlock x:Name="ScoreText"
                       Foreground="White"
                       FontSize="30"
                       Margin="30,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>

